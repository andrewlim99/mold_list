#!/usr/bin/env bash
# Deploy completed code-only ZIP releases from the mounted Synology share.
# Live JSON data and uploaded files are intentionally excluded.
set -euo pipefail
IFS=$'\n\t'
umask 027

APP_ROOT=/opt/mold-dashboard
RELEASE_DIR='/mnt/mold-nas/4. CE WEEKLY REPORT/mold_backup_data/mold-dashboard-releases'
STATE_DIR=/var/lib/mold-dashboard-deploy
ROLLBACK_DIR="$STATE_DIR/rollbacks"
RELEASE_COPY_DIR="$STATE_DIR/releases"
HISTORY_FILE="$STATE_DIR/deployed.sha256"
LOG_FILE="$STATE_DIR/deployments.log"
LOCK_FILE=/run/mold-dashboard-deploy.lock

EXCLUDES=(
  --exclude='mold_shared_rows.json'
  --exclude='mold_management.json'
  --exclude='mold_management.lock'
  --exclude='drawings/'
  --exclude='work_orders/'
  --exclude='repair_photos/'
  --exclude='Backups/'
  --exclude='*.before_*'
  --exclude='*.backup_*'
  --exclude='*.lock'
  --exclude='*.log'
  --exclude='.DS_Store'
  --exclude='Thumbs.db'
)

log() {
  local message="$*"
  printf '%s | %s\n' "$(date --iso-8601=seconds)" "$message" | tee -a "$LOG_FILE"
}

mkdir -p "$ROLLBACK_DIR" "$RELEASE_COPY_DIR"
touch "$HISTORY_FILE" "$LOG_FILE"
chmod 0700 "$STATE_DIR" "$ROLLBACK_DIR" "$RELEASE_COPY_DIR"
chmod 0600 "$HISTORY_FILE" "$LOG_FILE"

exec 9>"$LOCK_FILE"
if ! flock -n 9; then
  log 'Skipped: another deployment is already running.'
  exit 0
fi

if ! mountpoint -q /mnt/mold-nas; then
  log 'Skipped: Synology NAS is not mounted.'
  exit 0
fi

if [[ ! -d "$RELEASE_DIR" ]]; then
  log "Skipped: release folder does not exist: $RELEASE_DIR"
  exit 0
fi

contains_runtime_data() {
  local archive="$1"
  zipinfo -1 "$archive" | grep -Eqi '(^|/)(mold_shared_rows\.json|mold_management\.json|mold_management\.lock|drawings/|work_orders/|repair_photos/|Backups/|\.DS_Store|Thumbs\.db|[^/]+\.log|[^/]+\.lock)$'
}

validate_powershell() {
  local source_root="$1"
  pwsh -NoLogo -NoProfile -NonInteractive -Command '
    param([string]$Root)
    $problems = @()
    Get-ChildItem -LiteralPath $Root -Recurse -Filter *.ps1 -File | ForEach-Object {
      $tokens = $null; $errors = $null
      [System.Management.Automation.Language.Parser]::ParseFile($_.FullName, [ref]$tokens, [ref]$errors) | Out-Null
      if ($errors.Count) { $problems += ($_.FullName + ": " + (($errors | ForEach-Object Message) -join "; ")) }
    }
    if ($problems.Count) { $problems | ForEach-Object { Write-Error $_ }; exit 1 }
  ' "$source_root"
}

validate_release_root() {
  local source_root="$1"
  local required
  for required in mold_dashboard.html mold_shared_server.ps1 mold_management.ps1 mold_management.js mold_work_order.js; do
    [[ -f "$source_root/$required" ]] || { log "Rejected: required file is missing: $required"; return 1; }
  done
  [[ -d "$source_root/assets" ]] || { log 'Rejected: assets directory is missing.'; return 1; }

  if find "$source_root" -type l -print -quit | grep -q .; then
    log 'Rejected: release contains a symbolic link.'
    return 1
  fi

  validate_powershell "$source_root" || { log 'Rejected: PowerShell syntax validation failed.'; return 1; }
  if command -v node >/dev/null 2>&1; then
    local js
    while IFS= read -r -d '' js; do node --check "$js"; done < <(find "$source_root" -type f -name '*.js' -print0)
  else
    log 'Warning: node is unavailable; JavaScript syntax validation was skipped.'
  fi
}

sync_code() {
  local source_root="$1"
  rsync -a --delete "${EXCLUDES[@]}" "$source_root/" "$APP_ROOT/"
}

wait_for_health() {
  local attempt
  for attempt in {1..20}; do
    if curl -fsS --max-time 5 http://127.0.0.1:3212/api/health >/dev/null; then return 0; fi
    sleep 1
  done
  return 1
}

deploy_release() {
  local archive="$1" checksum stage source_root rollback stamp deployed=0
  checksum=$(sha256sum "$archive" | awk '{print $1}')

  if grep -qxF "$checksum" "$HISTORY_FILE"; then
    log "Skipped already deployed release: $(basename "$archive") ($checksum)"
    return 0
  fi

  if ! unzip -tqq "$archive"; then
    log "Skipped incomplete or invalid ZIP: $(basename "$archive")"
    return 0
  fi
  if contains_runtime_data "$archive"; then
    log "Release contains runtime data; it will be ignored and preserved on the server: $(basename "$archive")"
  fi

  stage=$(mktemp -d /var/tmp/mold-dashboard-release.XXXXXX)
  trap 'rm -rf "$stage"' RETURN
  unzip -q "$archive" -d "$stage"

  mapfile -t dashboards < <(find "$stage" -type f -name mold_dashboard.html -print)
  if [[ ${#dashboards[@]} -ne 1 ]]; then
    log "Rejected: ZIP must contain exactly one mold_dashboard.html: $(basename "$archive")"
    return 0
  fi
  source_root=$(dirname "${dashboards[0]}")
  if ! validate_release_root "$source_root"; then return 0; fi

  stamp=$(date +%Y%m%d_%H%M%S)
  rollback="$ROLLBACK_DIR/$stamp"
  mkdir -p "$rollback"
  rsync -a --delete "${EXCLUDES[@]}" "$APP_ROOT/" "$rollback/"

  log "Deploying $(basename "$archive") ($checksum)"
  if ! systemctl stop mold-dashboard; then
    log 'Deployment aborted: could not stop mold-dashboard.'
    return 1
  fi
  deployed=1

  if ! sync_code "$source_root" || ! chown -R moldapp:moldapp "$APP_ROOT" || ! systemctl start mold-dashboard || ! wait_for_health; then
    log "Deployment failed; restoring rollback $rollback"
    sync_code "$rollback" || true
    chown -R moldapp:moldapp "$APP_ROOT" || true
    systemctl restart mold-dashboard || true
    return 1
  fi

  cp -f "$archive" "$RELEASE_COPY_DIR/${checksum}.zip"
  printf '%s\n' "$checksum" >> "$HISTORY_FILE"
  log "Deployed successfully: $(basename "$archive") ($checksum); rollback: $rollback"
  deployed=0
}

shopt -s nullglob
release_count=0
for archive in "$RELEASE_DIR"/*.zip; do
  release_count=$((release_count + 1))
  deploy_release "$archive"
done
if [[ $release_count -eq 0 ]]; then
  log 'No ZIP releases found; nothing to deploy.'
fi
